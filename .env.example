# Copy this file to .env and fill in your own Neon connection string.
# Get it from the Neon dashboard: Project -> Connect -> "Connection string" (choose "Pooled connection").
DATABASE_URL=postgresql://user:password@ep-example-12345.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Optional: override the port the local server listens on.
# PORT=3001

# Required for admin login sessions - any long random string. Generate one with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-string

# Used once by scripts/seed-root-admin.js to create the permanent root System Admin - not read
# by the server itself, safe to leave unset day-to-day.
# ROOT_ADMIN_PASSWORD=

# Required for the "AI assistant" agreement-definition chat in agreements.html. Get a free key
# (no credit card needed) from Google AI Studio: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# Optional: override which Gemini model the chat uses (default: gemini-3.5-flash - some of the
# newest models like gemini-3.8-flash/gemini-flash-latest can return 503 "high demand" errors).
# GEMINI_MODEL=
